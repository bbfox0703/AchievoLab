<Window x:Class="RunGame.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RunGame"
        xmlns:models="clr-namespace:RunGame.Models"
        x:Name="Root"
        Title="AchievoLab:RunGame"
        Width="1400" Height="800">

    <Window.Styles>
        <!-- Applied to the status column while a row has an unsaved staged change. -->
        <Style Selector="TextBlock.staged">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top: Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,4">
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                               Text="Reload all achievements and statistics from Steam. Discards every ticked change you have not stored yet (scheduled timers are kept), and shows the live state."/>
                </ToolTip.Tip>
            </Button>
            <Button x:Name="StoreButton" Content="Store" Click="OnStore">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="380" TextWrapping="Wrap"
                               Text="Write the ticked states to Steam. Every achievement whose checkbox differs from its current state is changed to match the checkbox — ticked becomes UNLOCKED, unticked becomes LOCKED. Rows you did not touch are left alone. Edited statistics are written too. Protected (🔒) items cannot be changed. A confirmation dialog lists exactly what will change before anything is written."/>
                </ToolTip.Tip>
            </Button>
            <Separator Width="1" Margin="4,4"/>
            <!-- These only tick/untick checkboxes; nothing is written until Store is pressed. -->
            <Button x:Name="UnlockAllButton" Content="Tick all" Click="OnUnlockAll">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                               Text="Tick every modifiable (non-protected) achievement, staging an unlock for each one that is still locked. Nothing is written until you press Store."/>
                </ToolTip.Tip>
            </Button>
            <Button x:Name="LockAllButton" Content="Untick all" Click="OnLockAll">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                               Text="Untick every modifiable (non-protected) achievement, staging a lock for each one that is currently unlocked. Nothing is written until you press Store."/>
                </ToolTip.Tip>
            </Button>
            <Button x:Name="InvertAllButton" Content="Invert all" Click="OnInvertAll">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                               Text="Flip the checkbox of every modifiable (non-protected) achievement, so locked ones are staged to unlock and unlocked ones are staged to lock. Nothing is written until you press Store."/>
                </ToolTip.Tip>
            </Button>
            <Button x:Name="ResetChangesButton" Content="Reset ticks" Click="OnResetStagedChanges">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                               Text="Discard every staged change and put all checkboxes back to the state Steam currently holds. Does not touch Steam or any scheduled timer."/>
                </ToolTip.Tip>
            </Button>
            <Separator Width="1" Margin="4,4"/>
            <ToggleButton x:Name="AutoMouseMoveButton" Content="Auto Mouse"
                          Click="OnAutoMouseMove">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                               Text="Toggle: periodically nudge the mouse cursor a few pixels so Steam and the game do not treat you as idle while long unlock timers run. Click again to stop."/>
                </ToolTip.Tip>
            </ToggleButton>
            <ToggleButton x:Name="TimerToggleButton" Content="Start Timer"
                          Click="OnTimerToggle">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                               Text="Master switch for scheduled unlocks. While ON, achievements you queue with 'Set Timer' unlock automatically at their scheduled time, the status indicator blinks, and a countdown to the next unlock is shown. While OFF nothing unlocks — schedules are kept, not cancelled, and any that fall due meanwhile are unlocked in their original order as soon as you switch it back on. The button reads 'Stop Timer' while active."/>
                </ToolTip.Tip>
            </ToggleButton>
            <Separator Width="1" Margin="4,4"/>
            <ToggleButton x:Name="ProtectUnlockAllButton" Content="Protect Completionist"
                          IsChecked="True" Click="OnToggleUnlockAllProtection">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="400" TextWrapping="Wrap"
                               Text="Safety guard (default ON). Prevents a game's &quot;unlock every achievement&quot; meta achievement (e.g. 'Unlock all achievements', 'Earn all achievements', '獲得所有成就', '取得所有獎盃') from being unlocked before every OTHER achievement is unlocked. Turn this OFF only if a later DLC added new achievements and you want to unlock the completionist achievement anyway."/>
                </ToolTip.Tip>
            </ToggleButton>
        </StackPanel>

        <!-- Main Content: TabControl -->
        <TabControl Grid.Row="1" x:Name="MainTabView">
            <!-- Achievements Tab -->
            <TabItem Header="Achievements">
                <Grid RowDefinitions="Auto,*">
                    <!-- Achievement Filters -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10">
                        <TextBox x:Name="SearchTextBox" PlaceholderText="Search achievements..." Width="200"
                                 ToolTip.Tip="Filter the list by achievement name, description or ID. Matches both the selected language and the English text."/>
                        <ToggleButton x:Name="ShowLockedButton" Content="Show Locked Only" Click="OnShowLockedToggle"
                                      ToolTip.Tip="Show only achievements that are still LOCKED. Turning this on turns off 'Show Unlocked Only'."/>
                        <ToggleButton x:Name="ShowUnlockedButton" Content="Show Unlocked Only" Click="OnShowUnlockedToggle"
                                      ToolTip.Tip="Show only achievements that are already UNLOCKED. Turning this on turns off 'Show Locked Only'."/>
                        <ComboBox x:Name="LanguageComboBox" PlaceholderText="Language" Width="120" SelectionChanged="OnLanguageChanged"
                                  ToolTip.Tip="Choose the language used for achievement names and descriptions."/>
                        <ComboBox x:Name="ColumnLayoutComboBox" PlaceholderText="Column Layout" Width="150" SelectionChanged="OnColumnLayoutChanged"
                                  ToolTip.Tip="Change the on-screen column width preset for easier reading."/>
                        <Button x:Name="SetTimerButton" Content="Set Timer" Click="OnSetTimer">
                            <ToolTip.Tip>
                                <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                           Text="Same input as Store — the ticked achievements — but applied at a date/time you pick instead of now, down to 0.1 second. Only ticks that would UNLOCK a locked achievement can be scheduled; ticks stay on while the timer is pending. A game's 'unlock all achievements' achievement is always unlocked last."/>
                            </ToolTip.Tip>
                        </Button>
                        <Button x:Name="ResetAllTimersButton" Content="Reset All Timers" Click="OnResetAllTimers"
                                ToolTip.Tip="Cancel every scheduled unlock timer."/>
                        <Button x:Name="ResetSelectedTimersButton" Content="Reset Ticked Timers" Click="OnResetSelectedTimers"
                                ToolTip.Tip="Cancel the scheduled unlock timers for the ticked achievements only, and clear their ticks."/>
                        <TextBlock Text="⚪ Timer Off" x:Name="TimerStatusText" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                        <TextBlock Text="" x:Name="NextUnlockText" VerticalAlignment="Center" MaxWidth="340"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                                   ToolTip.Tip="Countdown to the next scheduled auto unlock while the timer is on, or a warning that pending schedules are paused while it is off."/>
                    </StackPanel>

                    <!-- Achievement List -->
                    <!-- Row selection no longer drives anything: Store and Set Timer both act on the
                         row checkboxes, so multi-select highlight would only suggest a meaning it
                         does not have. Single selection is kept for keyboard navigation. -->
                    <ListBox Grid.Row="1" x:Name="AchievementListView"
                             SelectionMode="Single"
                             Margin="10,0,10,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AchievementInfo">
                                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="2" Padding="10">
                                    <Grid ColumnDefinitions="60,60,150,220,250,300,180,180,80">
                                        <!-- Checkbox: the state you WANT. Ticked = should be unlocked.
                                             Store writes every row whose tick differs from the status column. -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding DesiredAchieved, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsNotProtected}"
                                                  Margin="0,0,10,0"
                                                  ToolTip.Tip="Tick to unlock this achievement, untick to lock it, then press Store. Protected achievements cannot be changed."/>

                                        <!-- Protection Indicator (only show for protected, unachieved) -->
                                        <TextBlock Grid.Column="0"
                                                   Text="🔒"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,-5,-5,0"
                                                   IsVisible="{Binding IsLockVisible, Mode=OneWay}"/>

                                        <!-- Achievement Icon -->
                                        <Border Grid.Column="1"
                                                Width="48" Height="48"
                                                CornerRadius="4"
                                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                Margin="0,0,10,0">
                                            <Grid>
                                                <Image Source="{Binding IconImage, Mode=OneWay}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="🏆"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                            </Grid>
                                        </Border>

                                        <!-- Current state (read-only). Shows "Locked → Unlocked" style
                                             text while the checkbox stages a change Store has not written. -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Classes.staged="{Binding IsModified}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- ID -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Id}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- Name -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- Description -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.8"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- Unlock Time (to 0.1s) -->
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding UnlockTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.f}'}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- Scheduled Time (to 0.1s) -->
                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding ScheduledUnlockTime, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.f}'}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                                                   Margin="0,0,10,0"/>

                                        <!-- Permission -->
                                        <TextBlock Grid.Column="8"
                                                   Text="{Binding Permission}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Statistics Tab -->
            <TabItem Header="Statistics">
                <Grid Margin="10" RowDefinitions="Auto,*">
                    <CheckBox Grid.Row="0" x:Name="EnableStatsEditingCheckBox"
                              Content="I understand that modifying stats can cause issues"
                              Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" x:Name="StatisticsListView"
                             IsEnabled="{Binding #EnableStatsEditingCheckBox.IsChecked}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:StatInfo">
                                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                        BorderThickness="1"
                                        Margin="2" Padding="10">
                                    <Grid ColumnDefinitions="150,250,150,150,120,100">
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding IsNotProtected}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding OriginalValueDisplay}" FontFamily="Consolas" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <CheckBox Grid.Column="4" IsChecked="{Binding IsIncrementOnly}" IsEnabled="False" Content="Increment Only" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Permission}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="DebugModeLabel" Text="" VerticalAlignment="Center"
                           Margin="10,0" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundAccentBrush}"/>
                <TextBlock Grid.Column="2" x:Name="TimerStatusLabel" Text="*" VerticalAlignment="Center" Margin="10,0" FontFamily="Consolas"/>
                <TextBlock Grid.Column="3" x:Name="CurrentTimeLabel" Text="" VerticalAlignment="Center" Margin="10,0" FontFamily="Consolas"/>
                <Button Grid.Column="4" x:Name="ClearLogButton" Content="Clear Log" Height="24" Margin="5,0" VerticalAlignment="Center" Click="OnClearLog" IsVisible="False"/>
                <ProgressBar Grid.Column="5" x:Name="LoadingBar" IsIndeterminate="True" Width="80" Height="16" Margin="10,0" IsVisible="False"/>
            </Grid>
        </Border>

    </Grid>
</Window>
